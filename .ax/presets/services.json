        {"id": "sample", "kind": "loop", "title": "샘플 데이터로 구현 (검수 루프)"},
        {"id": "checks", "kind": "check", "title": "품질 검사"},
        {"id": "full-run", "kind": "human", "title": "전체 실행 승인"}
      ],
      "edges": [["contract", "approve-contract"], ["approve-contract", "sample"], ["sample", "checks"], ["checks", "full-run"], ["full-run", "sample", "수정 요청"]]
    }
  },

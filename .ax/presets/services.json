        {"id": "implement", "kind": "loop", "title": "구현 (검수 에이전트와 루프)"},
        {"id": "checks", "kind": "check", "title": "하네스 검사 실행"},
        {"id": "review", "kind": "human", "title": "사람 최종 리뷰"}

      "edges": [["clarify", "spec"], ["spec", "approve-spec"], ["approve-spec", "spec", "수정 요청"], ["approve-spec", "implement", "승인"], ["implement", "checks"], ["checks", "review"], ["review", "implement", "수정 요청"]]

        {"id": "options", "kind": "agent", "agent": "ax-planner", "title": "선택지 2~3개 제안"},
        {"id": "choose", "kind": "human", "title": "방향 선택"},
        {"id": "prototype", "kind": "loop", "title": "프로토타입 (검수 루프)"},
        {"id": "review", "kind": "human", "title": "사람 판단"}
      ],
      "edges": [["research", "options"], ["options", "choose"], ["choose", "prototype"], ["prototype", "review"], ["review", "options", "다시 탐색"]]
    },
    "data": {
      "title": "데이터형: 계약 정의 → 샘플 실행 루프 → 검증 → 전체 실행 승인",
